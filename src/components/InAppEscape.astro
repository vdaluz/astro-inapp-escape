---
interface Props {
  /** Override the interstitial copy shown to iOS in-app-browser visitors. */
  message?: string;
  class?: string;
}

const {
  message = 'For the best experience, open this in your browser: tap ••• (or the Safari icon), then "Open in Safari".',
  class: className,
} = Astro.props;
---

<div
  id="inapp-escape-banner"
  hidden
  class={className ?? 'bg-accent-soft text-fg border-border border-b px-4 py-3 text-sm'}
  role="status"
>
  {message}
</div>

<script>
  import { detectInApp } from '../lib/detect.ts';
  import { buildAndroidIntentUrl, decideEscape } from '../lib/escape.ts';

  const action = decideEscape(detectInApp().isInApp, navigator.userAgent);
  if (action === 'redirect') {
    window.location.href = buildAndroidIntentUrl(window.location.href);
  } else if (action === 'banner') {
    document.getElementById('inapp-escape-banner')?.removeAttribute('hidden');
  }
</script>
